# AACTIVATED Data Core — environment template
# Copy to .env (never commit .env). No real credentials belong in git.

# PostgreSQL connection string for the Data Core database.
# Example (local):  postgres://postgres@localhost:5432/aactivated_data_core
# Production value is provisioned separately and stored ONLY in the runtime
# secret manager (e.g. Vercel project environment variables).
DATABASE_URL=

# Set to "require" for managed providers that enforce TLS (Neon, Supabase, RDS).
# Leave empty for local development over unix sockets.
DATABASE_SSL=

# Optional: connection string used ONLY by the integration test suite.
# When unset, tests boot a throwaway local PostgreSQL cluster if the
# postgres binaries are available, and skip integration tests otherwise.
TEST_DATABASE_URL=
