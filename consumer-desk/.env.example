# Consumer Desk — environment template. PLACEHOLDERS ONLY. Copy to .env.local and fill in.
# Never commit real values. All variables are server-side; none are sent to the browser.

# ---------------------------------------------------------------------------------------------
# Data mode
#   demo     = in-memory FICTIONAL data, resets on restart, local development only (default)
#   supabase = private connected app (Supabase Auth + PostgreSQL + private Storage)
# ---------------------------------------------------------------------------------------------
DATA_MODE=demo

# ---------------------------------------------------------------------------------------------
# Mailing (server-enforced). Defaults are the safe values below.
#   MAIL_MODE: mock | provider_test | live
#   LIVE_MAILING_ENABLED must ALSO be "true" before MAIL_MODE=live can submit anything.
#   Demo data can only ever use MAIL_MODE=mock.
# ---------------------------------------------------------------------------------------------
MAIL_MODE=mock
LIVE_MAILING_ENABLED=false

# ---------------------------------------------------------------------------------------------
# Connected mode (DATA_MODE=supabase)
#   Use the project URL and the anon/publishable key. NEVER put the service-role key here;
#   it is only used once, from your own computer, by `npm run create-owner`.
# ---------------------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# The single email address allowed to sign in (must match the owner created by create-owner).
OWNER_EMAIL=you@example.com
# Set to true once your authenticator app is enrolled, to refuse access without MFA.
REQUIRE_MFA=false

# ---------------------------------------------------------------------------------------------
# LetterStream (NOT YET IMPLEMENTED — awaiting your account's API documentation).
# Presence is shown in Settings / Test Center as "configured", never the values.
# ---------------------------------------------------------------------------------------------
LETTERSTREAM_TEST_API_ID=
LETTERSTREAM_TEST_API_KEY=
LETTERSTREAM_TEST_BASE_URL=
LETTERSTREAM_LIVE_API_ID=
LETTERSTREAM_LIVE_API_KEY=
LETTERSTREAM_LIVE_BASE_URL=
# Version/date of the LetterStream documentation the adapter was built against (informational).
LETTERSTREAM_DOCS_VERSION=

# ---------------------------------------------------------------------------------------------
# Local testing only — never set on a deployed server.
#   Allows the demo sign-in shortcut on a loopback address when running a production build
#   (`next start`) for end-to-end tests. Ignored on Vercel and on non-localhost hosts.
# ---------------------------------------------------------------------------------------------
DEMO_ALLOW_PRODUCTION_BUILD=false
