{
  "name": "consumer-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:supabase": "node scripts/with-local-supabase.mjs vitest run tests/integration",
    "test:e2e": "next build && playwright test",
    "test:e2e:connected": "node scripts/with-local-supabase.mjs env E2E_MODE=connected E2E_OWNER_EMAIL=e2e-owner@example.test E2E_OWNER_PASSWORD=Local-e2e-only-2026 playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "create-owner": "node scripts/create-owner.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
