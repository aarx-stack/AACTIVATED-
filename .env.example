# ---------------------------------------------------------------------------
# AACTIVATED AI Brain — environment variables
# Copy to .env and adjust. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# development | test | staging | production
APP_ENV=development
APP_URL=http://localhost:3000

# Database (docker-compose provides this locally)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aactivated_dev?schema=public
# Used only by integration tests. Gets reset on every test run.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aactivated_test?schema=public

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string
AUTH_TRUST_HOST=true
# Sign-in links always use APP_URL (above), never the host the request claims to be for.

# Magic-link email delivery: "console" logs the link to the server terminal,
# "smtp" sends through EMAIL_SERVER (Mailpit locally: smtp://localhost:1025).
EMAIL_TRANSPORT=console
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM="AACTIVATED AI Brain <no-reply@aactivated.test>"

# Dev-only "sign in as demo user" picker. Refused at startup when APP_ENV=production.
DEMO_LOGIN_ENABLED=true

# AI provider: "mock" (default, free, deterministic) or "anthropic"
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_BRAIN=claude-opus-5-5
ANTHROPIC_MODEL_AGENT=claude-sonnet-5-5
# "inline" runs agent workflows during the request (simplest for development);
# "queue" hands them to the background worker (recommended in production).
AGENT_EXECUTION=inline

# Integrations: "mock" (default) or "live". "live" calls the real service, so set it only after
# approval, with credentials below. Without credentials a live integration reports DOWN and
# refuses every call. Any integration can also be turned off in Admin at any time.
INTEGRATION_GOHIGHLEVEL=mock
INTEGRATION_QUICKBOOKS=mock
INTEGRATION_SLACK=mock
# GoHighLevel private integration token, the company location id, and (to list rep
# sub-accounts) the agency company id.
GOHIGHLEVEL_API_KEY=
GOHIGHLEVEL_LOCATION_ID=
GOHIGHLEVEL_COMPANY_ID=
# QuickBooks Online, read-only. "sandbox" or "production".
QUICKBOOKS_ENVIRONMENT=sandbox
# Recommended: the Intuit app's OAuth client id and secret. A system admin or executive then
# clicks "Connect QuickBooks" in Admin once; access renews automatically. Register this
# redirect URI in the Intuit app: <APP_URL>/api/integrations/quickbooks/callback
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# Encrypts stored OAuth tokens. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Alternative for a quick sandbox test only: a company (realm) id and a short-lived access token
# (expires in about an hour; nothing renews it).
QUICKBOOKS_REALM_ID=
QUICKBOOKS_ACCESS_TOKEN=
# Slack incoming webhook for internal alerts.
SLACK_WEBHOOK_URL=
