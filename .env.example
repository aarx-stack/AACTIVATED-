# ============================================================================
# Tapfiliate tier webhook — environment variables
# Set these in Vercel: Project Settings -> Environment Variables.
# NEVER commit real values to git.
# ============================================================================

# --- Required ---

# Tapfiliate API key: Tapfiliate dashboard -> Settings -> API keys
TAPFILIATE_API_KEY=

# Shared secret for the webhook URL. Generate one, e.g.: openssl rand -hex 24
# Then register the webhook in Tapfiliate as:
#   https://<your-domain>/api/tapfiliate-webhook?token=<WEBHOOK_TOKEN>
WEBHOOK_TOKEN=

# --- Safety (IMPORTANT) ---

# Defaults to true. The endpoint only logs what it WOULD do until you
# explicitly set this to false.
DRY_RUN=true

# --- Optional ---

# Optional, advanced: Tapfiliate does NOT sign webhooks today (its Triggers
# feature has no signing secret), so leave this empty for a normal setup —
# the ?token= above is the authentication. Set this only if you route the
# webhook through a proxy that adds an HMAC-SHA256 signature header
# (X-Tapfiliate-Hmac / X-Hub-Signature-256) over the raw body.
TAPFILIATE_WEBHOOK_SECRET=

# Limit tier math to one program (recommended). Program slug from Tapfiliate.
TAPFILIATE_PROGRAM_ID=aactivatedrx

# IANA timezone defining "the current calendar month". Default UTC.
# Use America/Los_Angeles to align with your local business month.
TIER_TIMEZONE=UTC

# Count pending (not-yet-approved) conversions toward the tier. Default true.
# Disapproved/refunded conversions NEVER count regardless of this setting.
COUNT_PENDING_COMMISSIONS=true

# Protected B2B groups (never auto-moved). Defaults cover
# "Competitive 40%", "Elevate 45%", "Strategic Partner 50%".
# PROTECTED_GROUP_KEYWORDS=competitive,elevate,strategic
# PROTECTED_GROUP_IDS=

# Explicit tier -> affiliate group ID overrides (skip title matching).
# TIER_GROUP_ID_STANDARD=
# TIER_GROUP_ID_STARTER=
# TIER_GROUP_ID_BUILDER=
# TIER_GROUP_ID_PRO=
# TIER_GROUP_ID_ELITE=

# Move affiliates that currently have NO group into their computed tier
# group. Default true.
ASSIGN_UNGROUPED_AFFILIATES=true

# --- Idempotency store (recommended for production) ---
# Add Upstash Redis (Vercel Marketplace) and these are injected automatically.
# Without them, idempotency falls back to per-instance memory (still safe:
# reprocessing recomputes the same tier and no-ops).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# IDEMPOTENCY_TTL_DAYS=40
