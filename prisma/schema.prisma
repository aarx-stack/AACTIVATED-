// AACTIVATED AI Brain — data model
// Conventions:
//  - Money is stored as Decimal (USD). Never floats.
//  - AuditLog is append-only; a database trigger (see migrations) rejects UPDATE/DELETE/TRUNCATE.
//  - Roles are an enum; the permission matrix lives in code (src/server/authz/permissions.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  EXECUTIVE
  STAFF
  PREMIUM_REP
  FREE_REP
  SYSTEM_ADMIN
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum ThemePreference {
  DARK
  LIGHT
  SYSTEM
}

enum AgentKind {
  BRAIN
  DEPARTMENT
  REP_POD
  /// One per executive, staff member and system admin. Only its owner works with it.
  PERSONAL
}

enum AgentStatus {
  ACTIVE
  IDLE
  PAUSED
  ERROR
  OFFLINE
}

enum RepAgentRole {
  CONTENT_CREATOR
  SOCIAL_MEDIA_MANAGER
  LEAD_FOLLOWUP
  BUSINESS_COACH
}

enum ActivityKind {
  PLANNED
  DELEGATED
  STARTED
  DRAFTED
  COMPLIANCE_CHECKED
  SUBMITTED_FOR_APPROVAL
  COMPLETED
  HANDOFF
  REPORTED
  FLAGGED
  ERROR
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum HandoffStatus {
  PENDING
  ACCEPTED
  COMPLETED
  REJECTED
}

enum ReportPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum ContentChannel {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  YOUTUBE
  EMAIL
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  REJECTED
}

enum ApprovalType {
  SOCIAL_POST
  EMAIL
  DIRECT_MESSAGE
  SPEND
  PAYMENT
  SITE_CHANGE
  LEGAL
  OUTSIDE_WORK
  PROJECT_LAUNCH
  /// A change to a budget's limit, requested by staff and decided by an executive.
  BUDGET_CHANGE
  /// Publishing an article, book or e-book outside the company. Executive decision.
  PUBLICATION
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  WITHDRAWN
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ComplianceOutcome {
  PASS
  WARN
  FAIL
}

enum ComplianceRuleType {
  BLOCKLIST_TERM
  PEPTIDE_NAME
  MEDICAL_CLAIM
  PLATFORM_RULE
}

enum BudgetStatus {
  OK
  WARNING
  LOCKED
}

enum SpendKind {
  AI_MODEL
  ADVERTISING
  SOFTWARE
  CONTRACTOR
  OTHER
}

enum TransactionType {
  REVENUE
  EXPENSE
  REFUND
}

enum TransactionSource {
  QUICKBOOKS
  MANUAL
}

enum DocumentCategory {
  POLICIES
  TRAINING
  LEGAL_RESEARCH
  BRAND
  PRODUCT_EDUCATION
}

enum AccessLevel {
  EXECUTIVE_ONLY
  ALL_STAFF
  ALL_USERS
}

enum ProjectPhase {
  IDEA
  BUILD
  REVIEW
  LAUNCH
}

enum IntegrationProvider {
  GOHIGHLEVEL
  QUICKBOOKS
  SLACK
  ANTHROPIC
}

enum IntegrationMode {
  MOCK
  LIVE
}

enum HealthStatus {
  OPERATIONAL
  DEGRADED
  DOWN
  UNKNOWN
}

enum ActorType {
  USER
  AGENT
  SYSTEM
}

enum NotificationKind {
  APPROVAL_REQUESTED
  APPROVAL_DECIDED
  BUDGET_ALERT
  COMPLIANCE_FLAG
  SYSTEM
  MENTION
}

enum PresenterStatus {
  NONE
  CANDIDATE
  PRESENTER
}

enum ConsentSource {
  WEB_FORM
  INBOUND_MESSAGE
  EVENT_SIGNUP
  REFERRAL_OPT_IN
}

enum ContactStatus {
  NEW
  FOLLOWING_UP
  CONVERTED
  OPTED_OUT
}

enum EarningKind {
  COMMISSION
  BONUS
  OVERRIDE
}

enum EarningStatus {
  PENDING
  APPROVED
  PAID
}

// ---------------------------------------------------------------------------
// Identity & auth (Auth.js tables + our user fields)
// ---------------------------------------------------------------------------

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  role          Role            @default(FREE_REP)
  status        UserStatus      @default(INVITED)
  theme         ThemePreference @default(DARK)
  title         String?
  departmentId  String?
  department    Department?     @relation("DepartmentMembers", fields: [departmentId], references: [id])
  onboardedAt   DateTime?
  lastActiveAt  DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  accounts           Account[]
  sessions           Session[]
  ownedDepartments   Department[]            @relation("DepartmentOwner")
  ownedAgents        Agent[]                 @relation("AgentOwner")
  repPod             RepPod?
  tasksCreated       Task[]                  @relation("TaskCreator")
  approvalsRequested ApprovalRequest[]       @relation("ApprovalRequester")
  approvalsDecided   ApprovalRequest[]       @relation("ApprovalDecider")
  approvalsEdited    ApprovalRequest[]       @relation("ApprovalEditor")
  complianceRules    ComplianceRule[]
  documents          Document[]
  promptVersions     PromptTemplateVersion[]
  templateVersions   AgentTemplateVersion[]
  projects           Project[]
  notifications      Notification[]
  auditEntries       AuditLog[]
  contentItems       ContentItem[]
  repProfile         RepProfile?             @relation("RepProfileUser")
  sponsoredReps      RepProfile[]            @relation("RepSponsor")
  contacts           Contact[]
  earnings           Earning[]
  payouts            Payout[]
  scheduledContent   ContentItem[]           @relation("ContentScheduler")
  emailCampaigns     EmailCampaign[]         @relation("CampaignAuthor")
  publications       Publication[]           @relation("PublicationAuthor")

  @@index([role])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Organisation & agents
// ---------------------------------------------------------------------------

model Department {
  id             String       @id @default(cuid())
  slug           String       @unique
  name           String
  description    String
  sortOrder      Int          @default(0)
  /// Legal, Finance and HR are company-confidential (EXECUTIVE-only detail views).
  isConfidential Boolean      @default(false)
  ownerId        String?
  owner          User?        @relation("DepartmentOwner", fields: [ownerId], references: [id])
  /// Set for a division (e.g. Credit Builder is a division of Finance).
  parentId       String?
  parent         Department?  @relation("Divisions", fields: [parentId], references: [id])
  divisions      Department[] @relation("Divisions")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members      User[]           @relation("DepartmentMembers")
  agents       Agent[]
  tasks        Task[]
  budgets      Budget[]
  spendEvents  SpendEvent[]
  transactions Transaction[]
  prompts      PromptTemplate[]
}

model Agent {
  id                String                @id @default(cuid())
  slug              String                @unique
  name              String
  /// The agent's job title, e.g. "Operations Manager".
  title             String
  kind              AgentKind
  status            AgentStatus           @default(IDLE)
  departmentId      String?
  department        Department?           @relation(fields: [departmentId], references: [id])
  /// Human owner accountable for this agent.
  ownerId           String
  owner             User                  @relation("AgentOwner", fields: [ownerId], references: [id])
  repPodId          String?
  repPod            RepPod?               @relation(fields: [repPodId], references: [id], onDelete: Cascade)
  repRole           RepAgentRole?
  /// ROLE / CONTEXT / DAILY_ROUTINE prompt blocks + allowed tools. Validated by zod in code.
  config            Json
  templateVersionId String?
  templateVersion   AgentTemplateVersion? @relation(fields: [templateVersionId], references: [id])
  monthlyBudgetUsd  Decimal?              @db.Decimal(12, 2)
  currentFocus      String?
  lastActiveAt      DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  tasks            Task[]
  activities       AgentActivity[]
  handoffsOut      Handoff[]         @relation("HandoffFrom")
  handoffsIn       Handoff[]         @relation("HandoffTo")
  reports          Report[]
  contentItems     ContentItem[]
  approvalRequests ApprovalRequest[]
  spendEvents      SpendEvent[]

  @@index([departmentId])
  @@index([repPodId])
}

/// Versioned agent blueprints. New rep pods copy the current best version ("carry forward what was learned").
model AgentTemplate {
  id             String                 @id @default(cuid())
  key            String                 @unique
  name           String
  repRole        RepAgentRole?
  currentVersion Int                    @default(1)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  versions       AgentTemplateVersion[]
}

model AgentTemplateVersion {
  id           String        @id @default(cuid())
  templateId   String
  template     AgentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version      Int
  role         String
  context      String
  dailyRoutine String
  toolsAllowed String[]
  changeNote   String?
  createdById  String?
  createdBy    User?         @relation(fields: [createdById], references: [id])
  createdAt    DateTime      @default(now())
  agents       Agent[]

  @@unique([templateId, version])
}

model RepPod {
  id        String   @id @default(cuid())
  repId     String   @unique
  rep       User     @relation(fields: [repId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agents    Agent[]
}

model AgentActivity {
  id        String       @id @default(cuid())
  agentId   String
  agent     Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  kind      ActivityKind
  message   String
  taskId    String?
  task      Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())

  @@index([createdAt])
  @@index([agentId, createdAt])
}

// ---------------------------------------------------------------------------
// Work
// ---------------------------------------------------------------------------

model Task {
  id           String       @id @default(cuid())
  title        String
  description  String?
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  agentId      String?
  agent        Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id])
  createdById  String?
  createdBy    User?        @relation("TaskCreator", fields: [createdById], references: [id])
  parentId     String?
  parent       Task?        @relation("Subtasks", fields: [parentId], references: [id])
  subtasks     Task[]       @relation("Subtasks")
  dueAt        DateTime?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  handoffs      Handoff[]
  activities    AgentActivity[]
  contentItems  ContentItem[]
  /// Groups every record created by one workflow run.
  correlationId String?
  /// What the agent produced for a prompt task: { summary, deliverable, nextSteps }. Internal only.
  output        Json?
  outputAt      DateTime?
  /// Why the agent could not finish, in plain words.
  lastError     String?

  @@index([status, completedAt])
  @@index([agentId])
}

model Handoff {
  id          String        @id @default(cuid())
  fromAgentId String
  fromAgent   Agent         @relation("HandoffFrom", fields: [fromAgentId], references: [id], onDelete: Cascade)
  toAgentId   String
  toAgent     Agent         @relation("HandoffTo", fields: [toAgentId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  status      HandoffStatus @default(PENDING)
  note        String
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?
}

model Report {
  id        String       @id @default(cuid())
  agentId   String
  agent     Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  period    ReportPeriod
  title     String
  body      String
  createdAt DateTime     @default(now())
}

model ContentItem {
  id             String         @id @default(cuid())
  title          String
  body           String
  channel        ContentChannel
  status         ContentStatus  @default(DRAFT)
  scheduledFor   DateTime?
  authorAgentId  String?
  authorAgent    Agent?         @relation(fields: [authorAgentId], references: [id], onDelete: SetNull)
  /// The rep this content belongs to, when produced by a rep pod.
  repId          String?
  rep            User?          @relation(fields: [repId], references: [id], onDelete: SetNull)
  /// The workflow task that produced this item.
  taskId         String?
  task           Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  /// Set when the approved post is handed to the social scheduler (GoHighLevel).
  externalPostId String?
  scheduledById  String?
  scheduledBy    User?          @relation("ContentScheduler", fields: [scheduledById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  approvalRequests ApprovalRequest[]
  complianceChecks ComplianceCheck[]

  @@index([scheduledFor])
}

// ---------------------------------------------------------------------------
// Approvals & compliance
// ---------------------------------------------------------------------------

model ApprovalRequest {
  id                 String         @id @default(cuid())
  type               ApprovalType
  title              String
  summary            String
  /// Exactly what will leave the building if approved.
  payload            Json
  /// sha256 of the canonical payload. Dispatch refuses if the payload changed after approval.
  payloadHash        String
  revision           Int            @default(1)
  /// The agent's reasoning — always shown above the decision buttons.
  reasoning          String
  /// [{ title, url?, note? }]
  sources            Json
  risk               RiskLevel
  status             ApprovalStatus @default(PENDING)
  /// Minimum role allowed to decide (computed from type + risk by the approval policy).
  requiredRole       Role           @default(STAFF)
  amountUsd          Decimal?       @db.Decimal(12, 2)
  requestedByAgentId String?
  requestedByAgent   Agent?         @relation(fields: [requestedByAgentId], references: [id], onDelete: SetNull)
  requestedByUserId  String?
  requestedByUser    User?          @relation("ApprovalRequester", fields: [requestedByUserId], references: [id])
  decidedById        String?
  decidedBy          User?          @relation("ApprovalDecider", fields: [decidedById], references: [id])
  decidedAt          DateTime?
  decisionNote       String?
  editedById         String?
  editedBy           User?          @relation("ApprovalEditor", fields: [editedById], references: [id])
  editedAt           DateTime?
  correlationId      String?
  /// For follow-up messages: the consented contact it is addressed to.
  /// Set once the approved item has been handed to the outside system. Prevents double sends.
  dispatchedAt       DateTime?
  contactId          String?
  contact            Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contentItemId      String?
  contentItem        ContentItem?   @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  budgetId           String?
  budget             Budget?        @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  complianceChecks ComplianceCheck[]
  projects         Project[]
  spendEvent       SpendEvent?

  @@index([status, createdAt])
}

model ComplianceCheck {
  id                String            @id @default(cuid())
  approvalRequestId String?
  approvalRequest   ApprovalRequest?  @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  contentItemId     String?
  contentItem       ContentItem?      @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  outcome           ComplianceOutcome
  risk              RiskLevel
  /// [{ ruleId, type, match, message, severity }]
  violations        Json
  checkedAt         DateTime          @default(now())
}

/// Executive-configurable content rules.
model ComplianceRule {
  id          String             @id @default(cuid())
  type        ComplianceRuleType
  /// A plain term, or a regular expression when isRegex is true.
  pattern     String
  isRegex     Boolean            @default(false)
  /// Empty = applies to every channel.
  channels    ContentChannel[]
  severity    RiskLevel          @default(HIGH)
  description String
  suggestion  String?
  active      Boolean            @default(true)
  createdById String?
  createdBy   User?              @relation(fields: [createdById], references: [id])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([active, type])
}

// ---------------------------------------------------------------------------
// Finance
// ---------------------------------------------------------------------------

model Budget {
  id           String       @id @default(cuid())
  name         String
  kind         SpendKind    @default(OTHER)
  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id])
  periodStart  DateTime
  periodEnd    DateTime
  limitUsd     Decimal      @db.Decimal(12, 2)
  /// Alert + lock threshold as a fraction of limit (business rule: 0.75).
  threshold    Decimal      @default(0.75) @db.Decimal(4, 3)
  status       BudgetStatus @default(OK)
  alertSentAt  DateTime?
  lockedAt     DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  spendEvents      SpendEvent[]
  approvalRequests ApprovalRequest[]

  @@index([periodStart, periodEnd])
}

model SpendEvent {
  id                String           @id @default(cuid())
  kind              SpendKind
  description       String
  amountUsd         Decimal          @db.Decimal(14, 6)
  budgetId          String?
  budget            Budget?          @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  agentId           String?
  agent             Agent?           @relation(fields: [agentId], references: [id], onDelete: SetNull)
  departmentId      String?
  department        Department?      @relation(fields: [departmentId], references: [id])
  /// Model-call fields (kind = AI_MODEL)
  provider          String?
  model             String?
  inputTokens       Int?
  outputTokens      Int?
  /// Set when this spend was a specific purchase approved in the Approval Queue (recorded once).
  approvalRequestId String?          @unique
  approvalRequest   ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)
  occurredAt        DateTime         @default(now())

  @@index([occurredAt])
  @@index([departmentId, occurredAt])
}

model Transaction {
  id           String            @id @default(cuid())
  occurredAt   DateTime
  description  String
  category     String
  type         TransactionType
  amountUsd    Decimal           @db.Decimal(14, 2)
  departmentId String?
  department   Department?       @relation(fields: [departmentId], references: [id])
  source       TransactionSource @default(MANUAL)
  externalId   String?           @unique
  createdAt    DateTime          @default(now())

  @@index([occurredAt])
}

// ---------------------------------------------------------------------------
// Knowledge, prompts, projects
// ---------------------------------------------------------------------------

model Document {
  id           String           @id @default(cuid())
  title        String
  category     DocumentCategory
  accessLevel  AccessLevel
  summary      String?
  /// AI summary key takeaways (set with summary).
  keyPoints    String[]         @default([])
  summarizedAt DateTime?
  body         String
  tags         String[]
  ownerId      String?
  owner        User?            @relation(fields: [ownerId], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([category, accessLevel])
}

model PromptTemplate {
  id             String                  @id @default(cuid())
  key            String                  @unique
  name           String
  description    String
  variables      String[]
  currentVersion Int                     @default(1)
  departmentId   String?
  department     Department?             @relation(fields: [departmentId], references: [id])
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  versions       PromptTemplateVersion[]
}

model PromptTemplateVersion {
  id          String         @id @default(cuid())
  templateId  String
  template    PromptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version     Int
  body        String
  changeNote  String?
  createdById String?
  createdBy   User?          @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())

  @@unique([templateId, version])
}

model Project {
  id                        String           @id @default(cuid())
  name                      String
  description               String
  phase                     ProjectPhase     @default(IDEA)
  /// Locked projects show "Pending Approval" and cannot advance without an executive decision.
  locked                    Boolean          @default(false)
  requiresExecutiveApproval Boolean          @default(false)
  isTokenization            Boolean          @default(false)
  /// Progress (0-100) within the current phase.
  progress                  Int              @default(0)
  /// False while the project is still an idea in the backlog, not yet on the map.
  onMap                     Boolean          @default(true)
  /// Short note per phase shown on its card: { IDEA?: string, BUILD?: string, ... }.
  stageNotes                Json             @default("{}")
  ownerId                   String?
  owner                     User?            @relation(fields: [ownerId], references: [id])
  approvalRequestId         String?
  approvalRequest           ApprovalRequest? @relation(fields: [approvalRequestId], references: [id])
  targetDate                DateTime?
  sortOrder                 Int              @default(0)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

model Integration {
  id            String              @id @default(cuid())
  provider      IntegrationProvider @unique
  name          String
  description   String
  mode          IntegrationMode     @default(MOCK)
  enabled       Boolean             @default(true)
  status        HealthStatus        @default(UNKNOWN)
  lastCheckedAt DateTime?
  lastError     String?
  /// Non-secret settings only. Secrets live in environment variables.
  config        Json                @default("{}")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

/// OAuth connection to an integration (QuickBooks). Tokens are encrypted at rest with
/// TOKEN_ENCRYPTION_KEY; they are never shown in the app or written to the audit log.
model IntegrationConnection {
  id               String              @id @default(cuid())
  provider         IntegrationProvider @unique
  /// The connected account (QuickBooks company / realm id). Not secret.
  accountId        String
  accessTokenEnc   String
  accessExpiresAt  DateTime
  refreshTokenEnc  String
  refreshExpiresAt DateTime
  connectedById    String?
  connectedAt      DateTime            @default(now())
  lastRefreshedAt  DateTime?
  updatedAt        DateTime            @updatedAt
}

/// Sliding-window rate limiting (sign-in requests). Old rows are pruned as new ones arrive.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model HealthCheck {
  id        String       @id @default(cuid())
  component String
  status    HealthStatus
  latencyMs Int?
  message   String?
  checkedAt DateTime     @default(now())

  @@index([component, checkedAt])
}

/// Append-only. Enforced by a database trigger; never update or delete rows.
model AuditLog {
  id            String    @id @default(cuid())
  actorType     ActorType
  actorUserId   String?
  actorUser     User?     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  actorAgentId  String?
  action        String
  entityType    String
  entityId      String?
  before        Json?
  after         Json?
  metadata      Json?
  /// Shared by every step of one workflow run, so the full trail can be shown together.
  correlationId String?
  createdAt     DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([correlationId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}

// ---------------------------------------------------------------------------
// Reps: profile, consented contacts, earnings
// ---------------------------------------------------------------------------

model RepProfile {
  id                 String          @id @default(cuid())
  userId             String          @unique
  user               User            @relation("RepProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  presenterStatus    PresenterStatus @default(NONE)
  /// The rep who brought this rep in (team growth).
  sponsorId          String?
  sponsor            User?           @relation("RepSponsor", fields: [sponsorId], references: [id])
  /// One GoHighLevel sub-account per Premium rep.
  ghlSubAccountId    String?
  policiesAcceptedAt DateTime?
  joinedAt           DateTime        @default(now())
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([sponsorId])
}

/// Lead generation is consent-only: every contact records where and when consent was given.
model Contact {
  id               String         @id @default(cuid())
  repId            String
  rep              User           @relation(fields: [repId], references: [id], onDelete: Cascade)
  name             String
  email            String?
  phone            String?
  preferredChannel ContentChannel @default(EMAIL)
  consentSource    ConsentSource
  consentAt        DateTime
  /// What the person did to opt in (e.g. "Submitted the Recovery guide form").
  consentEvidence  String
  status           ContactStatus  @default(NEW)
  notes            String?
  lastContactedAt  DateTime?
  ghlContactId     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  approvalRequests ApprovalRequest[]

  @@index([repId, status])
}

model Earning {
  id          String        @id @default(cuid())
  repId       String
  rep         User          @relation(fields: [repId], references: [id], onDelete: Cascade)
  /// First day of the month the earning belongs to.
  period      DateTime
  kind        EarningKind
  status      EarningStatus @default(PENDING)
  amountUsd   Decimal       @db.Decimal(12, 2)
  description String
  createdAt   DateTime      @default(now())

  @@index([repId, period])
}

model Payout {
  id        String   @id @default(cuid())
  repId     String
  rep       User     @relation(fields: [repId], references: [id], onDelete: Cascade)
  amountUsd Decimal  @db.Decimal(12, 2)
  paidAt    DateTime
  method    String
  reference String
  createdAt DateTime @default(now())

  @@index([repId, paidAt])
}

// ---------------------------------------------------------------------------
// Email campaigns (sent through GoHighLevel, after approval)
// ---------------------------------------------------------------------------

/// Who a campaign goes to. Company audiences are GoHighLevel contacts with a tag; MY_CONTACTS
/// is a Premium rep's own consented contacts.
enum EmailAudience {
  CLINICS
  MEMBERS
  REPS
  MY_CONTACTS
}

enum CampaignStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SENDING
  SENT
  REJECTED
}

enum EmailSendStatus {
  SENT
  SKIPPED
  FAILED
}

model EmailCampaign {
  id                String         @id @default(cuid())
  name              String
  audience          EmailAudience
  subject           String
  /// Plain text; paragraphs separated by blank lines. The unsubscribe footer is added on send.
  body              String
  status            CampaignStatus @default(DRAFT)
  createdById       String
  createdBy         User           @relation("CampaignAuthor", fields: [createdById], references: [id])
  /// Set for a rep's campaign to their own contacts.
  repId             String?
  approvalRequestId String?        @unique
  recipientEstimate Int?
  sentAt            DateTime?
  sentCount         Int            @default(0)
  skippedCount      Int            @default(0)
  failedCount       Int            @default(0)
  lastError         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  sends EmailSend[]

  @@index([status, createdAt])
  @@index([repId])
}

/// One row per recipient per campaign: makes sending exactly-once per person.
model EmailSend {
  id           String          @id @default(cuid())
  campaignId   String
  campaign     EmailCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// GoHighLevel contact id (company audiences) or the app's contact id (a rep's contacts).
  recipientKey String
  name         String?
  email        String?
  status       EmailSendStatus
  reason       String?
  externalId   String?
  createdAt    DateTime        @default(now())

  @@unique([campaignId, recipientKey])
}

/// People who unsubscribed. Checked before every send. Stores a hash, not the address.
model EmailSuppression {
  id         String   @id @default(cuid())
  emailHash  String   @unique
  campaignId String?
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Publishing: articles, books and e-books
// ---------------------------------------------------------------------------

enum PublicationKind {
  ARTICLE
  EBOOK
  BOOK
}

enum PublicationStatus {
  DRAFTING
  IN_REVIEW
  APPROVED
  REJECTED
}

model Publication {
  id                String            @id @default(cuid())
  title             String
  subtitle          String?
  kind              PublicationKind
  /// Who it is for (e.g. "new members", "clinic staff").
  audience          String
  description       String
  status            PublicationStatus @default(DRAFTING)
  authorId          String
  author            User              @relation("PublicationAuthor", fields: [authorId], references: [id])
  approvalRequestId String?           @unique
  /// Hash of the exact text that was approved. Edits after approval show as "changed".
  approvedHash      String?
  approvedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  sections PublicationSection[]

  @@index([status, updatedAt])
}

/// A chapter (book, e-book) or section (article), in order.
model PublicationSection {
  id            String      @id @default(cuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  position      Int
  title         String
  /// What this chapter should cover (from the outline). Guides AI drafting.
  summary       String      @default("")
  body          String      @default("")
  /// Who wrote the current text: a person, or which agent.
  writtenBy     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([publicationId, position])
}

// ---------------------------------------------------------------------------
// Credit Builder (a division of Finance): the company's credit and business profile
// ---------------------------------------------------------------------------

enum CreditCategory {
  FOUNDATION
  BUREAUS
  TRADELINES
  MONITORING
}

enum CreditStepStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum TradelineKind {
  VENDOR_NET30
  CREDIT_CARD
  LINE_OF_CREDIT
  LOAN
}

enum TradelineStatus {
  APPLIED
  OPEN
  CLOSED
  DECLINED
}

enum CreditBureau {
  DNB_PAYDEX
  EXPERIAN_INTELLISCORE
  EQUIFAX_BUSINESS
  FICO_SBSS
}

/// One step of the credit-building plan.
model CreditMilestone {
  id          String           @id @default(cuid())
  key         String           @unique
  category    CreditCategory
  title       String
  description String
  sortOrder   Int              @default(0)
  status      CreditStepStatus @default(NOT_STARTED)
  /// Free text. Never full account numbers or the full EIN.
  notes       String           @default("")
  completedAt DateTime?
  updatedById String?
  updatedAt   DateTime         @updatedAt
}

/// An account that can report to the business credit bureaus.
model Tradeline {
  id          String          @id @default(cuid())
  vendor      String
  kind        TradelineKind
  /// Which bureaus it reports to (D&B, Experian, Equifax).
  reportsTo   String[]
  limitUsd    Decimal?        @db.Decimal(12, 2)
  openedAt    DateTime?
  status      TradelineStatus @default(APPLIED)
  notes       String          @default("")
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

/// A business credit score, entered by hand from the bureau's report.
model CreditScore {
  id           String       @id @default(cuid())
  bureau       CreditBureau
  score        Int
  recordedAt   DateTime
  note         String?
  recordedById String
  createdAt    DateTime     @default(now())

  @@index([bureau, recordedAt])
}
